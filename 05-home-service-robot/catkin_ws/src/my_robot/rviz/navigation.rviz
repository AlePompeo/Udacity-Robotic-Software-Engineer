Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      Visual Enabled: true
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Enabled: true
      Name: Map
      Topic: /map
    - Alpha: 0.5
      Class: rviz/Map
      Color Scheme: costmap
      Enabled: true
      Name: Local costmap
      Topic: /move_base/local_costmap/costmap
    - Alpha: 1
      Class: rviz/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Lines
      Name: Global plan
      Topic: /move_base/NavfnROS/plan
    - Alpha: 1
      Class: rviz/Path
      Color: 255; 255; 0
      Enabled: true
      Line Style: Lines
      Name: Local plan
      Topic: /move_base/DWAPlannerROS/local_plan
    - Alpha: 1
      Arrow Length: 0.3
      Class: rviz/PoseArray
      Color: 0; 200; 0
      Enabled: true
      Name: Particle cloud (AMCL)
      Topic: /particlecloud
    - Alpha: 1
      Class: rviz/LaserScan
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Enabled: true
      Name: LaserScan
      Size (m): 0.05
      Style: Points
      Topic: /scan
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /visualization_marker
      Name: Object marker
      Namespaces: {}
      Queue Size: 100
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 22
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.5
      Target Frame: <Fixed Frame>
      Yaw: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1200
