<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <!-- Arguments for launch file with defaults provided -->
  <arg name="database_path" default="$(env HOME)/.ros/rtabmap.db"/>
  <arg name="rgb_topic" default="/camera/rgb/image_raw"/>
  <arg name="depth_topic" default="/camera/depth/image_raw"/>
  <arg name="camera_info_topic" default="/camera/rgb/camera_info"/>
  <arg name="rtabmapviz" default="false"/>
  <arg name="loop_thr" default="0.05"/>
  <arg name="min_inliers" default="8"/>
  <arg name="optimize_max_error" default="3.0"/>
  <!-- rtabmap_ros older than 0.21 (the course): defaults. rtabmap_ros 0.21 or newer: slam_pkg:=rtabmap_slam viz_pkg:=rtabmap_viz viz_type:=rtabmap_viz -->
  <arg name="slam_pkg" default="rtabmap_ros"/>
  <arg name="viz_pkg" default="rtabmap_ros"/>
  <arg name="viz_type" default="rtabmapviz"/>

  <!-- Mapping node -->
  <group ns="rtabmap">
    <node name="rtabmap" pkg="$(arg slam_pkg)" type="rtabmap" output="screen" args="--delete_db_on_start">

      <!-- Basic RTAB-Map parameters -->
      <param name="database_path" type="string" value="$(arg database_path)"/>
      <param name="frame_id" type="string" value="robot_footprint"/>
      <param name="odom_frame_id" type="string" value="odom"/>
      <param name="subscribe_depth" type="bool" value="true"/>
      <param name="subscribe_scan" type="bool" value="true"/>

      <!-- RTAB-Map inputs -->
      <remap from="scan" to="/scan"/>
      <remap from="rgb/image" to="$(arg rgb_topic)"/>
      <remap from="depth/image" to="$(arg depth_topic)"/>
      <remap from="rgb/camera_info" to="$(arg camera_info_topic)"/>

      <!-- RTAB-Map output -->
      <remap from="grid_map" to="/map"/>

      <!-- Rate (Hz) at which new nodes are added to the map -->
      <param name="Rtabmap/DetectionRate" type="string" value="1"/>

      <!-- 2D SLAM -->
      <param name="Reg/Force3DoF" type="string" value="true"/>

      <!-- Loop closure detection: 0=SURF 1=SIFT 2=ORB 3=FAST/FREAK 4=FAST/BRIEF 5=GFTT/FREAK 6=GFTT/BRIEF 7=BRISK 8=GFTT/ORB 9=KAZE -->
      <param name="Kp/DetectorStrategy" type="string" value="1"/>

      <!-- Maximum visual words per image (bag-of-words) -->
      <param name="Kp/MaxFeatures" type="string" value="1000"/>

      <param name="Rtabmap/LoopThr" type="string" value="$(arg loop_thr)"/>
      <!-- Used to extract more or less SURF features -->
      <param name="SURF/HessianThreshold" type="string" value="100"/>

      <!-- Loop closure constraint: 0=Visual, 1=ICP (1 requires scan) -->
      <param name="Reg/Strategy" type="string" value="0"/>

      <!-- Reject loop closures that make the pose graph error grow too much (lower = stricter) -->
      <param name="RGBD/OptimizeMaxError" type="string" value="$(arg optimize_max_error)"/>

      <!-- Minimum visual inliers to accept a loop closure -->
      <param name="Vis/MinInliers" type="string" value="$(arg min_inliers)"/>

      <!-- Do not save data when the robot is not moving -->
      <param name="Mem/NotLinkedNodesKept" type="string" value="false"/>
    </node>

    <!-- Real-time visualization (heavy in simulation): rtabmapviz:=true -->
    <node pkg="$(arg viz_pkg)" type="$(arg viz_type)" name="rtabmapviz" args="-d $(find rtabmap_ros)/launch/config/rgbd_gui.ini" output="screen" if="$(arg rtabmapviz)">
      <param name="subscribe_depth" type="bool" value="true"/>
      <param name="subscribe_scan" type="bool" value="true"/>
      <param name="frame_id" type="string" value="robot_footprint"/>

      <remap from="rgb/image" to="$(arg rgb_topic)"/>
      <remap from="depth/image" to="$(arg depth_topic)"/>
      <remap from="rgb/camera_info" to="$(arg camera_info_topic)"/>
      <remap from="scan" to="/scan"/>
    </node>
  </group>

</launch>
