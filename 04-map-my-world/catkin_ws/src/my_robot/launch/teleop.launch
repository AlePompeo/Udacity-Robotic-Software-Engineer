<?xml version="1.0"?>
<launch>

  <!-- Keyboard teleoperation in its own terminal (needs xterm). Without xterm run: rosrun teleop_twist_keyboard teleop_twist_keyboard.py -->
  <node name="teleop_twist_keyboard" pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" output="screen" launch-prefix="xterm -e"/>

</launch>
