Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
    - Alpha: 0.7
      Class: rviz/Map
      Enabled: true
      Name: Map
      Topic: /map
    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/rgb/image_raw
      Name: Camera
    - Class: rviz/LaserScan
      Color: 255; 0; 0
      Enabled: true
      Name: LaserScan
      Size (m): 0.05
      Style: Points
      Topic: /scan
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 16
      Pitch: 1.5
      Target Frame: <Fixed Frame>
      Yaw: 0
Window Geometry:
  Height: 900
  Width: 1200
