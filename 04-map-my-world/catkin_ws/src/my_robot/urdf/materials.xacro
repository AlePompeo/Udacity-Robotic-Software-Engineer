<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Colors used by RViz; the Gazebo colors are set in my_robot.xacro -->
  <material name="chassis_color">
    <color rgba="0.35 0.7 0.95 1"/>
  </material>
  <material name="wheel_color">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>
  <material name="camera_color">
    <color rgba="0.85 0.1 0.1 1"/>
  </material>

</robot>
